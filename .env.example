# Settings for --http. Over stdio, only LOG_LEVEL and the UPSTREAM_ settings apply.
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# The URL clients use. With oauth, it's also the expected token audience.
MCP_PUBLIC_URL=http://localhost:3000/mcp

# Comma-separated Host headers to accept. Defaults to localhost and the MCP_PUBLIC_URL host.
MCP_ALLOWED_HOSTS=

# oauth, token, or none. None works only on a loopback HOST.
MCP_AUTH_MODE=token

# token mode: comma-separated tokens, at least 16 characters each.
MCP_AUTH_TOKENS=dev-token-change-me-0123

# oauth mode: the issuer. The JWKS URL is discovered unless you set it. Both need https://,
# as does MCP_PUBLIC_URL, except on a loopback host. See docs/auth.md for a local Keycloak.
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URL=

# Space-separated scopes every token must have.
MCP_AUTH_SCOPES=mcp

# Set to turn on the notes tools, which call a REST API. See docs/upstream.md.
UPSTREAM_API_URL=
# static sends UPSTREAM_API_TOKEN. exchange swaps each caller's OAuth token (RFC 8693).
UPSTREAM_AUTH=static
UPSTREAM_API_TOKEN=
# The total time each call may take, in milliseconds.
UPSTREAM_TIMEOUT_MS=5000

# exchange mode only.
UPSTREAM_AUDIENCE=
TOKEN_EXCHANGE_URL=
TOKEN_EXCHANGE_CLIENT_ID=
TOKEN_EXCHANGE_CLIENT_SECRET=

# After SIGTERM: fail /readyz while serving, then let requests in flight finish.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Set to export OpenTelemetry traces and metrics over OTLP/HTTP. See docs/deploy.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
